# Each side keeps its own rules (FastApiBackend/.gitignore, VueFrontend/.gitignore).
# This file only covers repo-wide things.

# Secrets / local env (templates named example.env / .env.example stay tracked)
.env
.env.*
!.env.example
!example.env

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.sw?

# Logs
*.log

# Build output & dependencies, wherever they appear (Docker builds these in the image)
node_modules/
.nuxt/
.output/
.nitro/
dist/
build/
__pycache__/
*.py[cod]
.venv/
venv/

# Generated / scratch
resume_data.json
